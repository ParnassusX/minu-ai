{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["dom", "dom.iterable", "es2017"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/types/*": ["./src/types/*"],
      "@/hooks/*": ["./src/lib/hooks/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "**/__tests__.disabled/**/*",
    "**/*.test.disabled.*",
    "**/*.spec.disabled.*",
    "temp-tests/**/*",
    "**/__tests__/**/*",
    "**/*.test.*",
    "**/*.spec.*",
    "src/components/ui/__tests__/OptimizedLoadingAndErrorHandling.test.tsx",
    "src/lib/validation/__tests__/dynamicParameterControls.test.ts",
    "src/components/generator/__tests__/ProgressiveParameterControls.test.tsx",
    "src/components/layout/__tests__/ResponsiveBreakpoints.test.tsx",
    "src/components/navigation/__tests__/GlassmorphismNavigation.test.tsx",
    "src/components/navigation/__tests__/UnifiedNavigation.test.tsx"
  ]
}
